LLM_PROVIDER=ollama
# Optional failover provider if primary fails (options: ollama, anthropic, groq; leave blank to disable fallback)
FALLBACK_PROVIDER=
LLM_TIMEOUT_S=900
LLM_TEMPERATURE=0.3

OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_NUM_CTX=4096

# Only required if LLM_PROVIDER or FALLBACK_PROVIDER is set to 'anthropic'
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

AUTO_INGEST=true
KB_PATH=/app/data/lennys-podcast-transcripts/episodes
KB_REPO_URL=https://github.com/ChatPRD/lennys-podcast-transcripts
RETRIEVAL_TOP_K=3
MIN_QUERY_COVERAGE=0.5

LOG_LEVEL=INFO
POSTGRES_PASSWORD=lenny
# Secret token to authorize POST /api/kb/reload via X-Admin-Token header (leave blank to disable reload endpoint)
ADMIN_TOKEN=
